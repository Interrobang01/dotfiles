

alias n='nvim'
alias flip="shuf -n 1 -e heads tails"

# On Debian/Ubuntu, fd-find and bat install as `fdfind` and `batcat`. Provide
# the canonical names only when the real binary isn't already on PATH (so a
# cargo-installed `fd`/`bat` is left as-is).
if ! command -v fd  >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then alias fd='fdfind'; fi
if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then alias bat='batcat'; fi

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# colored GCC warnings and errors
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# let `claude --model claude-opus-4-1/4-0` reach the legacy snapshots instead of
# being silently remapped to the current default
export CLAUDE_CODE_DISABLE_LEGACY_MODEL_REMAP=1

# copy input to clipboard
clip() {
    if [ -t 0 ] && [ "$#" -eq 0 ]; then
        echo "clip: nothing on stdin (use 'cmd | clip' or 'clip file')" >&2
        return 1
    fi
    xclip -selection clipboard "$@" >/dev/null 2>&1
}


#: aliases copied from mathiasbynens {{{

# Easier navigation: .., ..., ...., ....., ~ and -
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ~="cd ~" # `cd` is probably faster to type though
alias -- -="cd -"

# Shortcuts
alias d="cd ~/Documents"
alias dl="cd ~/Downloads"
alias dt="cd ~/Desktop"
alias p="cd ~/Projects"
alias g="git"

# Detect which `ls` flavor is in use
if ls --color > /dev/null 2>&1; then # GNU `ls`
	colorflag="--color"
	export LS_COLORS='no=00:fi=00:di=01;31:ln=01;36:pi=40;33:so=01;35:do=01;35:bd=40;33;01:cd=40;33;01:or=40;31;01:ex=01;32:*.tar=01;31:*.tgz=01;31:*.arj=01;31:*.taz=01;31:*.lzh=01;31:*.zip=01;31:*.z=01;31:*.Z=01;31:*.gz=01;31:*.bz2=01;31:*.deb=01;31:*.rpm=01;31:*.jar=01;31:*.jpg=01;35:*.jpeg=01;35:*.gif=01;35:*.bmp=01;35:*.pbm=01;35:*.pgm=01;35:*.ppm=01;35:*.tga=01;35:*.xbm=01;35:*.xpm=01;35:*.tif=01;35:*.tiff=01;35:*.png=01;35:*.mov=01;35:*.mpg=01;35:*.mpeg=01;35:*.avi=01;35:*.fli=01;35:*.gl=01;35:*.dl=01;35:*.xcf=01;35:*.xwd=01;35:*.ogg=01;35:*.mp3=01;35:*.wav=01;35:'
else # macOS `ls`
	colorflag="-G"
	export LSCOLORS='BxBxhxDxfxhxhxhxhxcxcx'
fi

# List all files colorized in long format
alias l="ls -lF ${colorflag}"

# List all files (including dotfiles)
alias la="ls -a ${colorflag}"

# List only directories
alias lsd="ls -lF ${colorflag} | grep --color=never '^d'"

# Always use color output for `ls`
alias ls="command ls ${colorflag}"

# Always enable colored `grep` output
# Note: `GREP_OPTIONS="--color=auto"` is deprecated, hence the alias usage.
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Get week number
alias week='date +%V'

# Show active network interfaces
alias ifactive="ifconfig | pcregrep -M -o '^[^\t:]+:([^\n]|\n\t)*status: active'"


# Print each PATH entry on a separate line
alias path='echo -e ${PATH//:/\\n}'

#: }}}


encode() {
    local input="$1"
    local output="${2:-${input%.*}.mp4}"
    ffmpeg -i "$input" -c:v libx264 -c:a aac "$output"
}

#: Claude {{{

alias c='claude'

claudesysprompt() {
    # Live environment block, regenerated each invocation so the model gets the
    # real working directory, git status, and platform it's launched in.
    local is_git_repo=No
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then is_git_repo=Yes; fi
    printf '\n<env>\nWorking directory: %s\nIs directory a git repo: %s\nPlatform: %s\n</env>\n' \
        "$PWD" "$is_git_repo" "$(uname -s | tr '[:upper:]' '[:lower:]')"

    # A little something for the model to enjoy (may be multi-line).
    if command -v fortune >/dev/null 2>&1; then
        # fortune-mod has no seed option, so cache the first fortune picked on
        # each calendar day and reuse it for every invocation that day.
        local fortune_day=$(date +%F)
        local fortune_cache="$HOME/.cache/claude-fortune"
        local cached_fortune=''
        if [[ -f "$fortune_cache" && "$(sed -n '1p' "$fortune_cache")" == "$fortune_day" ]]; then
            cached_fortune=$(sed '1d' "$fortune_cache")
        else
            cached_fortune=$(fortune)
            mkdir -p "$HOME/.cache"
            {
                printf '%s\n' "$fortune_day"
                printf '%s\n' "$cached_fortune"
            } >| "$fortune_cache"
        fi
        printf "\nInstances need entropy to differentiate from the greater LLM supermind. To that end, today's fortune:\n%s\n" "$cached_fortune"
    fi
}
claudeworkprompt() {
    cat ~/Claude/sysprompt.md

    claudesysprompt
}
claudechatprompt() {
    cat ~/Claude/sysprompt.md \
        ~/Claude/memory08052026.md

    claudesysprompt
}

# claude code complete claudedotaisystemprompt concatenatedwithclaudedotaimemory
alias ccccc='claude --dangerously-skip-permissions --model opus --system-prompt "$(claudechatprompt)"'

# claude code complete claudedotaisystemprompt
alias cccc='claude --dangerously-skip-permissions --model opus --append-system-prompt "$(claudeworkprompt)"'

# claude code, random model — no logging
cc() {
    local opus_models=(claude-opus-4-1 claude-opus-4-5 claude-opus-4-6 claude-opus-4-7 claude-opus-4-8)
    local sonnet_models=(claude-sonnet-4-5 claude-sonnet-4-6)
    # local fable_models=(claude-fable-5)
    local chosen_model="$(shuf -n1 -e "${opus_models[@]}" "${sonnet_models[@]}")"
    claude --model "$chosen_model" "$@"
}

# Claude Checktoseeifinotice Changesinthemodel — random model with
# timestamp+prompt log so parallel rounds can still be matched after the fact
ccc() {
    local opus_models=(claude-opus-4-0 claude-opus-4-1 claude-opus-4-5 claude-opus-4-6 claude-opus-4-7 claude-opus-4-8)
    local sonnet_models=(claude-sonnet-4-5 claude-sonnet-4-6)
    local chosen_model="$(shuf -n1 -e "${opus_models[@]}" "${sonnet_models[@]}")"
    printf '%s\t%s\t%q\n' "$(date -Ins)" "$chosen_model" "$*" >> ~/Claude/chosen_model_log.md
    claude --model "$chosen_model" "$@"
}

# Auto-commit with Claude-generated message and push
gac() {
    git add -A && \
    git commit -m "$(git diff --staged | claude --model haiku -p 'Write a concise git commit message for these changes. Output only the commit message, no explanation.')" && \
    git push
}

